# ---------------------------------------------------------------
# Amcom frontend environment. Copy to .env.local and adjust.
# NEVER put secrets here: everything prefixed VITE_ is shipped to
# the browser. Paystack secret keys, Cloudinary API secrets and
# ZeptoMail tokens live ONLY on the Laravel backend.
# ---------------------------------------------------------------
VITE_APP_NAME=Amcom
VITE_APP_URL=https://amcom.com

# Base URL of the versioned Laravel API (no trailing slash)
# VITE_API_BASE_URL=https://api.amcom.com/api/v1
VITE_API_BASE_URL=https://amcom.iterationplus.com/api/v1
VITE_API_TIMEOUT_MS=20000

# true = serve every request from src/mocks (no backend needed)
VITE_USE_MOCK_API=false
VITE_MOCK_LATENCY_MS=450

# Optional: proxy /api to Laravel in `npm run dev` (then set VITE_API_BASE_URL=/api/v1)
# VITE_DEV_API_PROXY=http://localhost:8000

VITE_SUPPORT_EMAIL=info@houvincity.com
VITE_SUPPORT_PHONE=+234 707 469 3320

# Show the "Continue with Google" button (backend must expose /auth/google/redirect)
VITE_GOOGLE_AUTH_ENABLED=true
