{
  "name": "amcom-frontend-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Amcom web frontend — Vue 3 + TypeScript client for the Amcom Laravel API.",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "media:mock": "python scripts/build_mock_media.py"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.13"
  }
}
